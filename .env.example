ROOT_DIR=
CREDIMI_INTERNAL_ADMIN_KEY=
CREDIMI_INTERNAL_APP_URL=
# Provision the internal admin key in api_keys; never commit a real key.
CREDIMI_API_KEY=replace-with-local-api-key
CREDIMI_TEMPORAL_SECRETS_ENCRYPTION_KEY=
OPENIDNET_TOKEN=
CREDIMI_ELASTIC_PASSWORD=
# Cloudflare Turnstile — anti-bot protection for the registration form
# How to obtain real keys:
#   1. Go to https://dash.cloudflare.com/ → Turnstile → Add Site
#   2. Enter your domain(s). "localhost" is auto-allowed for local dev.
#   3. Copy the Site Key → PUBLIC_TURNSTILE_SITE_KEY (public, inlined at build time)
#   4. Copy the Secret Key → TURNSTILE_SECRET_KEY (private, runtime only, never in client code)
# For deployment on Coolify, add both as environment variables (PUBLIC_* as a build arg).
#
# Production and local deployments must provide real Turnstile credentials.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
